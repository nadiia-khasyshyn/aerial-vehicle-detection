# data & run artefacts (live in the workspace, not the repo)
*.mp4
!examples/*.mp4
dataset*/
crops*/
output*/
eval_run/
runs/

# model files: only the shipped checkpoint belongs in the repo
*.pt
*.ts
!weights/*.pt

__pycache__/
*.pyc
.DS_Store
.env
.env.*

# clips are fetched with data/videos/fetch.sh, not committed
data/videos/*.mp4

# scratch copies of the dataset produced while experimenting
dataset_zoom*/

# drop folder for inference: the folders are tracked, the clips are not
videos/in/*
videos/out/*
!videos/in/.gitkeep
!videos/out/.gitkeep
!videos/README.md
